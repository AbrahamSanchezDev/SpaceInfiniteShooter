  m_text: '<color=yellow><b>Movement & Combat</b></color>

    <color=yellow>WASD
    / Arrows:</color> Move & Rotate

    <color=yellow>Space:</color> Engine Boost
    (Uses Plasma)

    <color=yellow>Left Click:</color> Fire Weapons

    <color=yellow>Right
    Click (Hold):</color> Siphon Resources


    <color=yellow><b>Exploration</b></color>

    <color=yellow>Radar
    Arrow:</color> Points to nearest Enemy or Asteroid

